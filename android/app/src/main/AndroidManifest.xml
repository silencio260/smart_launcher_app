<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Discover RSS feed fetching -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Good Morning weather card: device location for Open-Meteo lookup.
         Only city-level accuracy is consumed (LocationChannel geocodes to a
         locality name), so COARSE is sufficient. FINE is commented out: it adds
         nothing the feature uses and triggers Play's Location Permissions
         Declaration form. Re-enable only if precise location is ever needed. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/> -->

    <!-- CAMERA is not used: the launcher only *opens* the system camera app via
         intent (no capture/preview API is called), which needs no permission.
         Commented out to drop the unnecessary Data safety declaration. -->
    <!-- <uses-permission android:name="android.permission.CAMERA"/> -->

    <!-- Contacts search + Calendar events were never fully wired (contact
         search has no Dart caller; calendar permission was never requested at
         runtime), so both features produced nothing. Commented out along with
         their dead code to drop the unused Data safety declarations. Re-enable
         only if the features are actually implemented. -->
    <!-- <uses-permission android:name="android.permission.READ_CONTACTS"/> -->
    <!-- <uses-permission android:name="android.permission.READ_CALENDAR"/> -->

    <!-- Notification badges (runtime permission on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Alarm scheduling + reliable ringing. USE_EXACT_ALARM (Android 13+) is
         the install-time grant Google blesses for alarm-clock apps and covers
         13+ on its own (no form, not revocable). SCHEDULE_EXACT_ALARM is the
         user-revocable/flagged one, so it's bounded to Android 12 (maxSdkVersion
         32) — the only versions that still need it, where it's auto-granted.
         WAKE_LOCK keeps the CPU up while ringing and USE_FULL_SCREEN_INTENT lets
         the alarm surface over the lockscreen. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- App Lock's foreground watcher (Usage-access polling) — no standard FGS
         category fits "lock apps", so it runs as specialUse (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>

    <!-- After-call action center: draw the post-call card over the dialer.
         Call-END detection reads only EXTRA_STATE from the PHONE_STATE
         broadcast, which is delivered without READ_PHONE_STATE; we never read
         the caller number/identity, so that sensitive permission is not needed. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Wallpaper read/write -->
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS"/>

    <!-- Widget hosting -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Icon pack queries -->
        <intent>
            <action android:name="org.adw.ActivityStarter.THEMES"/>
        </intent>
        <intent>
            <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON"/>
        </intent>
        <!-- Widget provider visibility -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        </intent>
        <!-- Alarm clock fallbacks used when standard AlarmClock intents fail. -->
        <package android:name="com.google.android.deskclock"/>
        <package android:name="com.android.deskclock"/>
    </queries>

    <application
        android:label="Smart Launcher"
        android:name=".SmartLauncherApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!-- Test-only AdMob App ID. Replace with this app's real App ID before release ads. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"
            tools:replace="android:value"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="false"
            android:stateNotNeeded="true"
            android:theme="@style/LauncherTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".features.AppLockBiometricActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/AppLockBiometricTheme" />

        <activity-alias
            android:name=".features.ClockActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_feature_clock"
            android:label="Clock"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".features.FileLockerActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_feature_file_locker"
            android:label="File Locker"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".features.AppLockerActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_feature_app_locker"
            android:label="App Locker"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".features.AppHiderActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_feature_app_hider"
            android:label="App Hider"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".features.CalculatorVaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_feature_calculator"
            android:label="Calculator"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".features.NotesVaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_feature_notes"
            android:label="Notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".features.WeatherVaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_feature_weather"
            android:label="Weather"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".features.BrowserVaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_feature_browser"
            android:label="Browser"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".features.AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"/>

        <!-- Foreground service that owns the ringing sound/vibration/wakelock. -->
        <service
            android:name=".services.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>

        <!-- Device-wide App Lock watcher: polls Usage access for the foreground
             app and draws the lock overlay for apps opened outside the launcher.
             specialUse FGS (no other category fits app locking). -->
        <service
            android:name=".services.AppLockWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Locks apps device-wide by detecting the foreground app via Usage access and covering locked apps with a passcode screen."/>
        </service>

        <!-- Transparent trampoline that hosts the vault's system file picker.
             MainActivity is singleTask, which drops SAF results, so the picker
             runs here (standard launch mode) and encrypts files itself. -->
        <activity
            android:name=".features.FileImportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="standard"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"/>

        <!-- Notification listener for badge counts -->
        <service
            android:name=".services.LauncherNotificationService"
            android:exported="true"
            android:label="Smart Launcher Notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- Accessibility service for sleep screen / recents actions.
             Commented out: BIND_ACCESSIBILITY_SERVICE is a top Play-rejection
             risk when used for non-accessibility purposes, and this service only
             powered two optional gestures (Sleep Screen / Open Recents). Those
             options have been removed from the Gestures picker. Re-enable this
             block only if those gestures are reinstated. -->
        <!--
        <service
            android:name=".services.LauncherAccessibilityService"
            android:exported="true"
            android:label="Smart Launcher Accessibility"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
        -->

        <!-- After-call detector. Listens only to call-state changes (no caller
             identity) to fire the post-call overlay. Declared disabled and
             enabled at runtime only when the user turns the feature on, so it
             costs nothing — and broadcasts nothing — while off. -->
        <receiver
            android:name=".receivers.AfterCallReceiver"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.SmartAlarmReceiver"
            android:exported="false"/>

        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widgets.ClockWidgetProvider"
            android:exported="true"
            android:icon="@mipmap/ic_feature_clock"
            android:label="Clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock"/>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
